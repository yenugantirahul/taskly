{
  "name": "minitrigger",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "docker compose up -d --wait && turbo --skip-infer run dev --no-update-notifier",
    "build": "turbo --skip-infer run build",
    "start": "turbo --skip-infer run start",
    "lint": "turbo --skip-infer run lint",
    "typecheck": "turbo --skip-infer run typecheck",
    "deps:up": "docker compose up -d --wait",
    "deps:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
