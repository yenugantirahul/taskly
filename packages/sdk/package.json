{
  "name": "@minitrigger/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for MiniTrigger",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "keywords": ["minitrigger", "sdk"],
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
