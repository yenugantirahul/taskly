PORT=5000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/minitrigger
APP_URL=http://localhost:3000
# Replace with a Resend key. The test sender only sends to your Resend account email.
RESEND_API_KEY=
EMAIL_FROM="Taskly <onboarding@resend.dev>"
# MIGRATE_ON_START=true
# MIGRATION_DATABASE_URL=postgresql://... (Neon direct URL, never the pooled URL)
# Optional session cache. Leave unset to run without Redis.
REDIS_URL=redis://localhost:6380
